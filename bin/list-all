#!/usr/bin/env bash
set -euo pipefail

REGISTRY_URL="https://dl.static-php.dev/static-php-cli/bulk/"

# Fetch the index page and extract versions
if [[ "$OSTYPE" == "darwin"* ]]; then
  curl "$REGISTRY_URL" | sed -n 's/.*php-\([0-9]\+\.[0-9]\+\.[0-9]\+\).*/\1/p' | sort -uV
else
  curl -s "$REGISTRY_URL" | grep -oP 'php-\K[0-9]+\.[0-9]+\.[0-9]+' | sort -uV
fi